# PortfolioPulse configuration. Copy to .env and adjust values.
# Never put real API keys here or in .env tracked by git.

APP_ENV=development
DATABASE_URL=sqlite:///./portfoliopulse.db

# Provider names. "mock" runs the pipeline fully offline (fixture providers, no
# search hits it produces are empty — use "demo" for a complete offline demo flow
# with fictional fixture data). "gemini" uses a real Gemini API key (paste it once
# via the /key page or set it below).
SEARCH_PROVIDER=mock
LLM_PROVIDER=mock
# GEMINI_MODEL=gemini-3.5-flash-lite

# Hard limits for collection and orchestration.
MAX_SOURCES_PER_RUN=20
MAX_RESEARCH_ROUNDS=2
HTTP_TIMEOUT_SECONDS=15
MIN_REQUEST_INTERVAL_SECONDS=1

EXPORT_DIR=./artifacts

# Optional: provider credentials. Add the variable names here only when a real
# provider is actually implemented (Step 3+). Example placeholder names:
# SEARCH_API_KEY=
# LLM_API_KEY=
